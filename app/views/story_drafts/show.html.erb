<div class="d-flex justify-content-between align-items-start masthead mb-3 gap-3">
  <div>
    <div class="mb-1"><span class="story-label"><%= @story_draft.label_name %></span></div>
    <h1 class="h3 mb-1"><%= @story_draft.headline %></h1>
    <p class="text-muted small mb-0">
      <%= link_to "← My story drafts", story_drafts_path, class: "text-muted" %>
      &nbsp;&middot;&nbsp; <%= @story_draft.beat.presence || "No beat" %>
    </p>
  </div>
  <div class="d-flex gap-2 flex-shrink-0">
    <%= link_to "Edit", edit_story_draft_path(@story_draft), class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to "Delete", story_draft_path(@story_draft),
          method: :delete,
          form: { data: { turbo_confirm: "Delete this draft and its source checks?" } },
          class: "btn btn-outline-danger btn-sm" %>
  </div>
</div>

<div class="row g-4 mb-4" style="max-width: 980px;">
  <div class="col-md-7">
    <h2 class="h6 text-muted section-rule">Your reporting notes</h2>
    <p class="notes-text mb-0"><%= @story_draft.notes %></p>
  </div>
  <div class="col-md-5">
    <h2 class="h6 text-muted section-rule">Sources</h2>
    <% if @story_draft.sources? %>
      <p class="notes-text small mb-0"><%= @story_draft.sources_text %></p>
    <% else %>
      <p class="text-muted fst-italic small mb-0">None listed yet. Every claim will show as unsourced.</p>
    <% end %>
  </div>
</div>

<div class="mb-4" style="max-width: 820px;">
  <%= render "story_drafts/check_button", story_draft: @story_draft, label: "Check sources", button_class: "btn btn-primary" %>
  <p class="text-muted small mt-2 mb-0">
    The check reads only the headline, label, beat, notes and sources above, never who you are. It lists each
    factual claim with its sourcing and how to firm it up, who is affected but not heard, words that lean, and the
    questions to ask next. It never says whether a claim is true and never writes the story. Typically takes
    5&ndash;15 seconds.
  </p>
</div>

<% if @source_checks.any? %>
  <h2 class="h6 text-muted mb-2">Earlier checks</h2>
  <ul class="list-unstyled small" style="max-width: 820px;">
    <% @source_checks.each do |check| %>
      <li class="mb-2">
        <%= link_to story_draft_source_check_path(@story_draft, check) do %>
          <%= check.generated_at ? "#{time_ago_in_words(check.generated_at)} ago" : "Unknown time" %>
        <% end %>
        &nbsp;
        <% if check.completed? %>
          <span class="text-muted"><%= check.summary_line %></span>
        <% else %>
          <span class="text-muted fst-italic"><%= check.failed? ? "could not be read" : "still running" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
