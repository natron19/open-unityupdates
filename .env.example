# ── App Branding ───────────────────────────────────────────────────────────────
APP_NAME="UnityUpdates Demo"
APP_TAGLINE="Your reporting notes in. A source check out."
APP_DESCRIPTION="An open source, single-feature demo of UnityUpdates."

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URL=postgres://localhost/open_unityupdates_development  # optional override

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── AI Operational Limits ──────────────────────────────────────────────────────
AI_CALLS_PER_USER_PER_DAY=50
AI_GLOBAL_TIMEOUT_SECONDS=45
AI_THINKING_BUDGET=1024          # gemini-2.5 thinking tokens per call, on top of each template's max_output_tokens (-1 = Gemini decides)
